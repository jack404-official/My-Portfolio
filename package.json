{
  "name": "rullzsy-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio Rullzsy — fully offline static site",
  "scripts": {
    "build:css": "tailwindcss -c assets/library/tailwindcss/tailwind.config.js -i assets/library/tailwindcss/input.css -o assets/css/style.css --minify",
    "build:icons": "esbuild src/lucide-icons.js --bundle --minify --format=iife --outfile=assets/library/lucide/lucide.min.js",
    "build": "npm run build:css && npm run build:icons"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "gsap": "^3.13.0",
    "lucide": "^0.469.0",
    "tailwindcss": "^3.4.17"
  }
}
